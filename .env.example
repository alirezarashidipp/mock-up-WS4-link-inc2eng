# Select openai or azure. Run the command again after changing settings.
LLM_PROVIDER=openai

# Required request temperature for the selected model or deployment.
LLM_TEMPERATURE=0.7

# Local OpenAI connection
OPENAI_API_KEY=
OPENAI_MODEL=

# Azure connection: used only when LLM_PROVIDER=azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Use the token scope and API version approved for your Azure resource.
AZURE_OPENAI_TOKEN_SCOPE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
# This is a deployment name, which can differ from the underlying model name.
AZURE_OPENAI_DEPLOYMENT=

# Optional corporate network settings
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
